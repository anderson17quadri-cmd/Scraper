{
  "manifest_version": 3,
  "name": "IG-Scraper Pro - Conector",
  "version": "1.0",
  "description": "Conecta a conta do Instagram logada nesse navegador direto no IG-Scraper Pro, sem copiar e colar sessionid.",
  "permissions": ["cookies", "storage", "activeTab"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
